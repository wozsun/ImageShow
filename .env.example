# ImageShow 环境变量完整目录。
# `.env` 只供 Docker Compose 做插值；compose.yaml 未显式引用的变量不会进入任何容器，
# 也不会影响首次生成 data/config.json。不要通过 env_file 注入整份文件。
# 完整参数范围、单位、阶段和交叉约束见 docs/guide/configuration.md#runtimeconfig-参数目录。

# 默认 Compose 注入：部署级必要数据库身份。
# ImageShow 与 PostgreSQL 每次启动共享这三项；这里的可预测默认值确保只复制
# compose.yaml 也能启动，任何非本地体验部署都必须替换密码。
# PostgreSQL 数据库名；非空。
DATABASE_NAME=imageshow
# PostgreSQL 用户名；非空。
DATABASE_USER=imageshow
# PostgreSQL 密码；非空。
DATABASE_PASSWORD=imageshow

# 默认 Compose 注入：首次管理员。
# 只在 PostgreSQL 尚无 super 管理员时读取；这里的可预测默认凭据仅供本地体验，
# 任何非本地体验部署都必须在首次启动前替换，已有 super 时可从部署环境移除。
# 首个 super 管理员用户名；1–32 字符，归一化为小写 slug。
ADMIN_USERNAME=admin
# 首个 super 管理员密码；8–128 字符，须同时包含字母和数字。
ADMIN_PASSWORD=ImageShow123

# 可选部署覆盖：默认 Compose 不注入。
# 内置拓扑使用代码默认值；外部 PostgreSQL / Redis 或自定义时区需逐项扩展
# services.imageshow.environment。内置 Redis 不接收任何项目变量，也不设置密码。
# PostgreSQL 主机名；非空。
DATABASE_HOST=postgresql
# PostgreSQL 端口；1–65535。
DATABASE_PORT=5432
# Redis 主机名；非空。
REDIS_HOST=redis
# Redis 端口；1–65535。
REDIS_PORT=6379
# Redis 逻辑库编号；0–15。
REDIS_DB=0
# 外部 Redis 密码；0–512 字符，空值表示不认证。
REDIS_PASSWORD=
# 本地图片时间使用的 IANA 时区。
TZ=UTC

# 以下为可选 RuntimeConfig 首次播种值。
# 使用时可在 compose.yaml 中插值，或直接写入 services.imageshow.environment。

# site
# 站点名称；去空白后非空。
SITE_NAME="ImageShow"
# 主站 DNS 域名；1–259 字符，可带 1–65535 端口。
SITE_DOMAIN="example.com"
# HTML 站点描述；0–200 字符。
SITE_DESCRIPTION="画廊与随机图片API"
# 站点图标路径或 HTTPS URL；1–2048 字符。
SITE_ICON_URL="/assets/brand/favicon.svg"
# 是否显示后台版本信息；true/false。
SITE_VERSION_ENABLED=true
# 版本信息是否链接 Release；true/false。
SITE_VERSION_LINK_ENABLED=true
# 根路径页面；home/gallery。
SITE_ROOT="home"
# 是否启用公共首页；true/false。
SITE_HOME_ENABLED=true
# 首页背景路径或 HTTPS URL；0–2048 字符，空值使用本站随机图。
SITE_HOME_BACKGROUND=""
# 首页 Banner 标识；1–160 字符。
SITE_HOME_BANNER_LABEL="ImageShow · A FAN-MADE PHOTO HANDBOOK"
# 首页 Banner 标题；1–80 字符，可换行。
SITE_HOME_BANNER_TITLE="我们一起，\n收藏这些瞬间。"
# 画廊默认分页量；1–200。
SITE_GALLERY_DEFAULT_LIMIT=60
# 画廊默认排序；latest/random。
SITE_GALLERY_ORDER="random"
# 随机图默认模式；proxy/redirect。
SITE_RANDOM_DEFAULT_METHOD="redirect"
# 静态资源子域标签；1–63 字符。
SITE_STATIC_SUBDOMAIN="static"
# 是否提供 robots.txt；true/false。
SITE_ROBOTS_ENABLED=false

# embed
# 是否开放嵌入页面；true/false。
EMBED_ENABLED=false
# 额外允许的 HTTPS origin；严格 JSON 数组，0–32 项，每项最多 320 字符、总长最多 4096 字符。
EMBED_ALLOWED_ORIGINS='[]'

# ingestion
# 单页面入库提交并发；1–128。
INGESTION_COMMIT_CONCURRENCY=5
# 单进程入库提交并发；1–512。
INGESTION_GLOBAL_COMMIT_CONCURRENCY=10
# 单进程入库提交字节预算；16–4096 MiB。
INGESTION_GLOBAL_COMMIT_BYTE_BUDGET_MB=512

# upload
# 单次上传条目软上限；1–1000。
UPLOAD_MAX_ITEMS=200
# 单个上传文件上限；大于 0 且不超过 200 MiB。
UPLOAD_MAX_FILE_SIZE_MB=100
# 上传原图长边上限；300–32000 px。
UPLOAD_MAX_LONG_EDGE=32000
# 上传与批量编辑分页量；1–100。
UPLOAD_LIST_PAGE_SIZE=20
# 单页面上传并发；1–128。
UPLOAD_CONCURRENCY=2
# 单进程上传处理并发；1–512。
UPLOAD_GLOBAL_CONCURRENCY=5

# import
# URL 导入是否填入原图 URL；true/false。
IMPORT_FILL_ORIGINAL_URL=true
# 无问题项时是否自动开始导入；true/false。
IMPORT_AUTO_IMPORT=true
# 单页面导入并发；1–128。
IMPORT_CONCURRENCY=2
# 单进程导入处理并发；1–512。
IMPORT_GLOBAL_CONCURRENCY=5
# 外链下载超时；5–300 秒。
IMPORT_FETCH_TIMEOUT_SECONDS=30
# URL 或 JSONL 单次条目软上限；1–1000。
IMPORT_MAX_ITEMS=200

# weibo：映射必须是严格 JSON，键为微博用户 ID，值为作者 slug。
# 单次微博链接软上限；1–50。
WEIBO_MAX_ITEMS=20
# 同时请求和解析的微博数；1–16。
WEIBO_CONCURRENCY=2
# 单进程微博上游请求并发；1–32。
WEIBO_GLOBAL_CONCURRENCY=5
# 微博用户 ID 到作者 slug；严格 JSON 对象，ID 为首位非零的 1–20 位数字，slug 为 1–32 字符。
WEIBO_AUTHOR_SLUGS='{}'

# normalize
# WebP 初始编码质量；1–100。
NORMALIZE_QUALITY=80
# 超体积后的质量递减步长；1–50。
NORMALIZE_QUALITY_STEP=5
# 最低编码质量；1–100，且不高于初始质量。
NORMALIZE_MIN_QUALITY=20
# 入库成品长边上限；512–32768 px。
NORMALIZE_MAX_LONG_EDGE=4500
# 入库成品目标体积；50–102400 KiB。
NORMALIZE_MAX_SIZE_KB=500
# 保留原 WebP 的体积阈值；0–102400 KiB。
NORMALIZE_SKIP_WEBP_UNDER_KB=700

# thumbnail
# 新缩略图长边；64–4096 px。
THUMBNAIL_LONG_EDGE=512
# 新缩略图编码质量；1–100。
THUMBNAIL_QUALITY=75

# admin
# 后台登录背景路径或 HTTPS URL；0–2048 字符，空值使用随机图。
ADMIN_LOGIN_BACKGROUND=""
# 后台图片分页量；10–200。
ADMIN_IMAGE_PAGE_SIZE=60
# 后台概览最近上传数量；1–50。
ADMIN_RECENT_UPLOADS=12
# 是否显示“未设置”主题卡片；true/false。
ADMIN_SHOW_UNSET_THEME_CARD=true

# background_job
# 存储移动清理任务并发；1–512。
BACKGROUND_JOB_MOVE_CLEANUP_CONCURRENCY=5
# 主题重分配任务并发；1–512。
BACKGROUND_JOB_THEME_REASSIGN_CONCURRENCY=5
# 存储迁移任务并发；1–512。
BACKGROUND_JOB_MIGRATE_CONCURRENCY=5

# security
# 登录会话有效期；300–31536000 秒。
SECURITY_SESSION_TTL_SECONDS=604800
# 单来源登录失败统计窗口；30–300 秒。
SECURITY_LOGIN_FAILURE_WINDOW_SECONDS=60
# 单来源登录失败阈值；3–500 次。
SECURITY_LOGIN_MAX_FAILURES=5
# 全局登录尝试统计窗口；60–600 秒。
SECURITY_LOGIN_GLOBAL_WINDOW_SECONDS=180
# 全局登录尝试阈值；5–1000 次。
SECURITY_LOGIN_GLOBAL_MAX_ATTEMPTS=10

# altcha
# 是否启用自托管 ALTCHA；true/false。
ALTCHA_ENABLED=true
# ALTCHA 挑战有效期；90–3600 秒。
ALTCHA_TTL_SECONDS=300
# PBKDF2 单次迭代成本；1000–100000，且与 counter max 的乘积不超过 100000000。
ALTCHA_COST=5000
# ALTCHA 计数下界；100–100000，且不高于 counter max。
ALTCHA_COUNTER_MIN=2000
# ALTCHA 计数上界；100–100000，且与 cost 的乘积不超过 100000000。
ALTCHA_COUNTER_MAX=5000

# log
# 日志级别；DEBUG、INFO、WARN、ERROR 或 OFF。
LOG_LEVEL="WARN"
# 单个日志文件上限；大于 0 且不超过 1024 MiB。
LOG_MAX_SIZE_MB=10
# 轮转日志文件保留数；1–100。
LOG_MAX_FILES=5
