{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/build/process-tree.d.mts",
        "scripts/tests/final-*.test.ts",
        "scripts/tests/server/isolation/*.mts",
        "scripts/tests/verify/source-contract.mjs",
        "scripts/tests/verify/version-contract.mjs",
        "scripts/tests/verify/markdown-links.mjs",
        "scripts/tests/verify/check-web-chunks.mjs",
        "scripts/tests/verify/runtime-image.mjs"
      ],
      "ignoreDependencies": [
        "@aws-sdk/client-s3",
        "@tanstack/react-query",
        "hono",
        "ipaddr.js",
        "pg",
        "pixi.js",
        "react",
        "react-dom",
        "react-router",
        "sharp"
      ]
    },
    "packages/server": {
      "entry": ["src/healthcheck-cli.ts"]
    },
    "packages/web": {
      "ignoreDependencies": ["remixicon"]
    }
  }
}
