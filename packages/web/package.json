{
  "name": "@imageshow/web",
  "version": "4.8.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "icons:generate": "node ../../scripts/build/generate-web-icons.mjs",
    "icons:check": "node ../../scripts/build/generate-web-icons.mjs --check",
    "build": "tsc -p tsconfig.json && vite build",
    "check:build": "node ../../scripts/build/check-web-chunks.mjs",
    "check": "tsc -p tsconfig.check.json"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@imageshow/shared": "file:../shared",
    "@tanstack/react-query": "^5.101.4",
    "@uiw/react-codemirror": "^4.25.11",
    "altcha": "^3.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "remixicon": "^4.9.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
