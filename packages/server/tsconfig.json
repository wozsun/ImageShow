{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2025",
      "DOM",
      "DOM.Iterable",
      "DOM.AsyncIterable",
      "WebWorker.ImportScripts",
      "ScriptHost",
      "ESNext.Collection"
    ],
    "outDir": "dist",
    "rootDir": "src",
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src"]
}
