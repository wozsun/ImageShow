{
  "name": "@imageshow/server",
  "version": "4.7.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "assemble": "node ../../scripts/build/copy-server-assets.mjs",
    "benchmark:ready-image-set-work": "node scripts/benchmarks/ready-image-set-work.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "start": "node --env-file-if-exists=../../.env dist/index.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1104.0",
    "@hono/node-server": "^2.1.0",
    "@imageshow/shared": "file:../shared",
    "altcha-lib": "^2.3.2",
    "fast-xml-parser": "^5.10.1",
    "file-type": "^22.0.1",
    "hono": "^4.13.0",
    "ioredis": "^6.0.0",
    "pg": "^8.22.0",
    "sharp": "^0.35.3",
    "undici": "^8.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.4",
    "typescript": "^7.0.2"
  }
