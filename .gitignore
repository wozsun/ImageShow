# Version-controlled project files
/*
!/.dockerignore
!/.env.example
!/.github/
!/.gitignore
!/AGENTS.md
!/compose.yaml
!/Dockerfile
!/docs/
!/knip.json
!/LICENSE
!/package-lock.json
!/package.json
!/packages/
!/README.md
!/scripts/
!/tsconfig.base.json

# Agent rules: open .agents, then track only process, spec and reference
!/.agents/
/.agents/*
!/.agents/process/
!/.agents/reference/
!/.agents/spec/

# Local files and generated output
.DS_Store
.env
*.key
node_modules/
dist/
*.tsbuildinfo
*.log
